# Pinned inputs for packaging/appimage/build.sh (sourced by Bash).
# Change a version only together with its sha256; build.sh refuses a
# download whose sha256 differs. Verified 2026-10-29 against GitHub's
# asset digests (and the runtime's GPG signature, key 570C77ACEA40C0F1
# B758902CBF96CCA56490F695 from the same release).

# https://github.com/AppImage/appimagetool/releases/tag/1.9.1
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0

# https://github.com/AppImage/type2-runtime/releases/tag/20251108
# Static runtime: needs only fusermount/fusermount3 on the user's PC (no
# libfuse2), or --appimage-extract-and-run without FUSE.
RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d

# Build container: Ubuntu 22.04 = glibc 2.35, the oldest glibc the
# AppImage needs (Ubuntu 22.04+, Debian 12+, Fedora 36+, any current Arch).
BUILD_IMAGE=ubuntu@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11
RUSTUP_INIT_URL=https://static.rust-lang.org/rustup/archive/1.29.2/x86_64-unknown-linux-gnu/rustup-init
RUSTUP_INIT_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
RUST_TOOLCHAIN=1.99.0
